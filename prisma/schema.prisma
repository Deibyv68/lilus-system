// LILUS — Sistema de gestión de ventas de jabones artesanales

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Productos ----------

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  description     String?
  shortName       String?  // nombre corto para etiqueta 2x1
  imageUrl        String?  // /uploads/products/xxx.jpg
  labelPdfUrl     String?  // PDF de etiqueta de producto (la que el usuario sube)
  price           Float    // precio de venta unitario (suelto)
  packPrice       Float?   // precio cuando va dentro de un pack; si null, usa price
  productionCost  Float    @default(0)
  weightGrams     Float?   // gramos, para envíos
  ingredients     String?  // texto libre, va en la etiqueta 2x1
  shelfLifeMonths Int?     @default(6) // meses de vida útil por defecto
  stock           Int      @default(0)  // stock manual (no se descuenta de packs)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ── Tienda pública ──
  // `isActive` decide si el producto se puede vender desde el sistema.
  // `isPublic` decide si además se muestra en la web. Son cosas distintas:
  // algo se sigue vendiendo por WhatsApp mientras todavía no tiene fotos
  // buenas para publicarlo. Nace en false — a la tienda se sale a propósito,
  // no por olvido.
  slug            String?  @unique // dirección pública: /jabon-de-carbon-activado
  tagline         String?  // una línea, se lee debajo del nombre en el catálogo
  isPublic        Boolean  @default(false)

  /// Aparece en la selección de tres de la portada.
  ///
  /// Existe porque el criterio automático no sirve: sin esto salían los
  /// tres primeros por orden alfabético, y en una marca de jabones eso
  /// ponía el acondicionador y el agua micelar de cara. Cuáles merecen
  /// esa vitrina es una decisión de quien vende, no de un ORDER BY.
  destacado       Boolean  @default(false)

  variants        ProductVariant[]
  packItems       PackItem[]
  orderItems      OrderItem[]
  productionUnits ProductionUnit[]
  recipes         Recipe[]
  storeImages     StoreImage[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String  // ej "Lavanda", "Avena", "Tamaño grande"
  sku       String  @unique
  price     Float?  // si null, hereda del producto
  stock     Int     @default(0)
  isActive  Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

// ---------- Packs ----------

model Pack {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  description     String?
  imageUrl        String?
  price           Float
  productionCost  Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ── Tienda pública ── (ver la nota en Product)
  slug     String?  @unique
  tagline  String?
  isPublic Boolean  @default(false)

  items       PackItem[]
  orderItems  OrderItem[]
  storeImages StoreImage[]
}

/// Las fotos que ve el cliente en la tienda.
///
/// Van aparte de `imageUrl` a propósito. Esa es la miniatura con la que se
/// trabaja adentro del sistema: sirve para reconocer el producto en una
/// lista y da igual si está mal iluminada. Estas son las de vender, no
/// tienen por qué ser las mismas, y no tienen por qué ser una sola.
///
/// Cuelga de un producto O de un pack — el mismo patrón que ya usa
/// OrderItem para apuntar a uno u otro.
model StoreImage {
  id        String  @id @default(cuid())
  productId String?
  packId    String?

  url String  // /uploads/store/xxx.webp
  /// Qué se ve en la foto. Lo lee quien navega sin ver, y también Google.
  alt String?

  sortOrder Int      @default(0) // la primera es la portada
  createdAt DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  pack    Pack?    @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([packId])
}

model PackItem {
  id        String @id @default(cuid())
  packId    String
  productId String
  quantity  Int    @default(1)

  pack    Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([packId, productId])
}

// ---------- Envíos ----------

model ShippingZone {
  id        String   @id @default(cuid())
  name      String   @unique // "Quito", "Fuera de Quito"
  isDefault Boolean  @default(false) // zona usada por defecto si no se selecciona
  createdAt DateTime @default(now())

  rates     ShippingRate[]
  addresses ShippingAddress[]
  orders    Order[]
}

model Carrier {
  id                  String   @id @default(cuid())
  name                String   @unique // "Servientrega", "Tramaco", "Laar"
  isActive            Boolean  @default(true)
  trackingUrlTemplate String?  // ej: "https://www.servientrega.com.ec/Tracking/?guia={tracking}"
  createdAt           DateTime @default(now())

  rates  ShippingRate[]
  orders Order[]
}

model ShippingRate {
  id        String  @id @default(cuid())
  zoneId    String
  carrierId String
  price     Float   // tarifa fija por envío
  notes     String?

  zone    ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  carrier Carrier      @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@unique([zoneId, carrierId])
}

// ---------- Clientes ----------

model Customer {
  id           String   @id @default(cuid())
  name         String
  cedula       String?  // cédula o RUC
  phone        String?  // teléfono que va en la etiqueta de envío
  contactPhone String?  // teléfono para WhatsApp / mensajes (puede ser distinto al de envío)
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses ShippingAddress[]
  orders    Order[]
}

model ShippingAddress {
  id         String  @id @default(cuid())
  customerId String
  zoneId     String? // Quito / Fuera de Quito
  province   String
  city       String
  address    String  // dirección principal
  reference  String? // referencia adicional
  isDefault  Boolean @default(false)

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zone     ShippingZone? @relation(fields: [zoneId], references: [id])
  orders   Order[]
}

// Necesitamos relación inversa
// (Prisma exige declarar la opuesta en ShippingZone -> addresses)

// ---------- Pedidos ----------

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique // ej "LILUS-000123"
  status             OrderStatus @default(PENDING)
  customerId         String
  shippingAddressId  String?
  carrierId          String?
  zoneId             String?
  shippingCost       Float       @default(0)
  subtotal           Float       @default(0)
  total              Float       @default(0)
  trackingNumber     String?     // guía de la transportadora
  shippedAt          DateTime?   // cuándo se marcó como enviado
  notes              String?
  source             String?     // "WhatsApp", "Instagram", "Manual", "Web"...
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  /// Dirección con la que el cliente ve su propio pedido, sin cuenta ni
  /// contraseña: /pedido/<token>.
  ///
  /// Es un valor aleatorio largo y no el `id` a propósito. Los cuid son
  /// difíciles de adivinar pero no están pensados para eso, y sobre todo
  /// son la llave que se usa en todo el sistema: si mañana un id aparece
  /// en un log, en una URL del panel o en un mensaje, no debería alcanzar
  /// para abrir el pedido de nadie. Este token solo sirve para eso.
  ///
  /// Nulo en los pedidos que se cargan a mano desde el panel: esos no se
  /// comparten con nadie.
  publicToken        String?     @unique

  /// Comprobante de la transferencia, subido por el cliente.
  paymentProofUrl    String?

  customer        Customer         @relation(fields: [customerId], references: [id])
  shippingAddress ShippingAddress? @relation(fields: [shippingAddressId], references: [id])
  carrier         Carrier?         @relation(fields: [carrierId], references: [id])
  zone            ShippingZone?    @relation(fields: [zoneId], references: [id])
  items           OrderItem[]
  productionUnits ProductionUnit[]
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  packId      String?
  itemName    String  // snapshot del nombre
  itemSku     String  // snapshot del SKU
  quantity    Int     @default(1)
  unitPrice   Float
  lineTotal   Float

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  pack    Pack?           @relation(fields: [packId], references: [id])
}

// Cada unidad física que se va a empaquetar (sirve para etiqueta 2x1).
// Si el pedido lleva un pack con 3 jabones, se generan 3 ProductionUnit.
model ProductionUnit {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  productName     String   // snapshot
  productSku      String   // snapshot
  batchCode       String   // lote: ej "L20260521-001"
  manufactureDate DateTime @default(now())
  expiryDate      DateTime // calculada en base a shelfLifeMonths
  ingredients     String?  // snapshot

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// ---------- Recetario ----------

model Recipe {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  // "base" | "jabon" | "crema" | "perfume" | "otro"
  category String
  summary  String? // una línea, se muestra en el listado
  imageUrl String?

  // Ficha técnica
  yield     String? // "250 g", "un frasco de 60 ml"
  restTime  String? // "24 horas"
  container String? // "cajita de metal", "frasco ámbar"
  usage     String? // modo de uso
  notes     String? // notas libres, una por línea

  // pH. Solo tiene sentido en productos con agua: en un perfume oleoso o
  // en un polvo no existe. Por eso el tipo, además del valor.
  phValue String? // "5.0 – 5.5"
  // "objetivo" = ajustar hasta ahí | "esperado" = solo verificar
  // null = no aplica
  phKind  String?

  // Producto del catálogo que sale de esta receta, si existe
  productId String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  benefits    RecipeBenefit[]

  // Recetas que usan ESTA como ingrediente (índice inverso)
  usedIn RecipeIngredient[] @relation("IngredienteEsReceta")

  @@index([category])
}

model RecipeIngredient {
  id       String  @id @default(cuid())
  recipeId String
  name     String
  quantity String? // "250 g", "4 gotas", "1/16 cucharadita"
  note     String? // "disuelta en 1 cucharada de agua"
  optional Boolean @default(false)
  // Agrupa ingredientes cuando la receta tiene variantes
  // (p. ej. las dos fórmulas de crema base)
  variant   String?
  sortOrder Int     @default(0)

  // Qué función cumple este ingrediente EN ESTA receta. No es lo mismo
  // que la categoría de la materia prima: la glicerina es humectante en
  // una crema y solvente en otra. Se muestra como etiqueta junto al
  // nombre para que se entienda para qué está cada cosa.
  role String?

  // ── Alternativas ──
  // Los ingredientes que comparten optionGroup son opciones excluyentes
  // entre sí: se muestran como un desplegable y solo una aplica a la vez.
  // Sirve para "usa este conservante, o este otro que ya tienes".
  optionGroup   String?
  optionLabel   String? // texto corto para el desplegable
  isRecommended Boolean @default(false)

  // Porcentaje sobre el total, cuando la dosis se define así
  // (conservantes, activos). Se muestra junto a los gramos.
  percentage Float?

  // Si este ingrediente se prepara con otra receta, se enlaza aquí.
  // Es lo que permite saltar de "glicerado de naranja" a su receta.
  linkedRecipeId String?

  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  linkedRecipe Recipe? @relation("IngredienteEsReceta", fields: [linkedRecipeId], references: [id], onDelete: SetNull)

  @@index([recipeId])
}

model RecipeStep {
  id        String  @id @default(cuid())
  recipeId  String
  text      String
  // Agrupa pasos cuando hay métodos alternativos
  // (p. ej. glicerado a fuego directo o a baño maría)
  variant   String?
  sortOrder Int     @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model RecipeBenefit {
  id       String  @id @default(cuid())
  recipeId String
  // Si viene, el beneficio es de un ingrediente concreto y se muestra
  // en tabla. Si es null, es un beneficio general de la receta.
  ingredient String?
  text       String
  sortOrder  Int     @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

// ---------- Diccionario ----------

/// Palabras y conceptos del recetario explicados en lenguaje llano.
/// Se enlazan automáticamente allí donde aparecen en una receta.
model GlossaryTerm {
  id   String @id @default(cuid())
  slug String @unique
  term String // "Catiónico"

  /// Otras formas de escribirlo, separadas por coma: plurales, femenino,
  /// sinónimos. Es lo que permite detectar la palabra en los textos.
  aliases String?

  /// Una línea. Es lo que se ve al tocar la palabra dentro de una receta.
  shortDef String
  /// Explicación completa, para la ficha del diccionario.
  longDef  String?
  /// Ejemplo sacado del propio recetario, para aterrizarlo.
  example  String?

  /// "quimica" | "ingrediente" | "proceso" | "medida" | "seguridad"
  category  String
  sortOrder Int    @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ---------- Inventario de materias primas ----------

model Material {
  id   String @id @default(cuid())
  slug String @unique
  name String // nombre de uso diario: "Colágeno hidrolizado"

  // "conservante" | "tensioactivo" | "emulsionante" | "activo" | "acido"
  // | "aceite" | "esencial" | "arcilla" | "vegetal" | "colorante"
  // | "aroma" | "base" | "auxiliar"
  category String

  inciName     String? // nombre INCI, el que no depende de la marca
  tradeName    String? // "Kemidant L"
  manufacturer String? // "Akema"
  purpose      String? // para qué sirve en la fórmula

  // ── Datos técnicos, de la ficha del proveedor ──
  usageMin     Float?  // % mínimo de uso
  usageMax     Float?  // % máximo de uso
  phMin        Float?
  phMax        Float?
  maxTemp      Float?  // °C máxima a la que se puede agregar
  solubility   String? // "agua" | "aceite" | "ambas" | "dispersable"
  leaveOn      Boolean? // apto para producto que se queda en la piel
  spectrum     String? // conservantes: contra qué protege
  incompatible String? // con qué no se lleva
  datasheetUrl String?

  // ── Conservación ──
  container         String? // envase requerido
  storage           String? // "ambiente" | "refrigerado"
  lightSensitive    Boolean @default(false)
  oxygenSensitive   Boolean @default(false)
  moistureSensitive Boolean @default(false)
  openedShelfLife   String? // vida útil una vez abierto

  notes     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots          MaterialLot[]
  shoppingItems ShoppingItem[]

  @@index([category])
}

/// Cada compra de una materia prima. Es lo que permite responder
/// "¿desde cuándo tenemos este frasco?" cuando algo sale mal.
model MaterialLot {
  id         String @id @default(cuid())
  materialId String

  supplier    String?
  purchasedAt DateTime?
  openedAt    DateTime? // la fecha que más importa para la vida útil
  expiresAt   DateTime?
  lotCode     String? // lote del fabricante

  quantity Float? // cantidad comprada
  unit     String? // "g" | "ml" | "kg" | "unidad"
  price    Float? // lo pagado, para poder costear después

  container String? // en qué envase llegó o se guardó
  // "sin-abrir" | "abierto" | "agotado" | "descartado"
  status    String  @default("sin-abrir")
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
}

// ---------- Listas de compra ----------

model ShoppingList {
  id        String    @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  items ShoppingItem[]
}

model ShoppingItem {
  id     String @id @default(cuid())
  listId String

  // O bien apunta a una materia prima del catálogo, o bien es texto
  // suelto para algo que todavía no está dado de alta.
  materialId String?
  freeText   String?

  // Cantidad como texto a propósito: en la tienda se pide "medio kilo"
  // o "el frasco grande", no 500.00 g.
  quantity String?
  note     String?
  checked  Boolean @default(false)

  sortOrder Int @default(0)

  list     ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  material Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([listId])
}

// ---------- Configuración global ----------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Autenticación ----------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("user") // "admin" | "user"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  trustedDevices TrustedDevice[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model TrustedDevice {
  id          String    @id @default(cuid())
  userId      String
  token       String    @unique // valor del cookie del dispositivo
  pinHash     String
  name        String?   // ej "iPhone de María"
  lastSeenAt  DateTime  @default(now())
  failedTries Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ---------- Cola de impresión ----------
// Pattern: el agente de impresión (en la PC del 1er piso) hace polling.
// LILUS crea PrintJob → agente lo recoge → imprime → marca como done/failed.

model PrintJob {
  id          String         @id @default(cuid())
  orderId     String?        // pedido del que viene (puede ser null para pruebas)
  kind        String         // "shipping" | "product-labels" | "expiry-labels" | "box-logo"
  printerName String         // nombre de la impresora destino en Windows
  copies      Int            @default(1)
  pdfBase64   String         // PDF a imprimir, encodeado
  status      PrintJobStatus @default(PENDING)
  error       String?
  agentName   String?        // qué PC lo agarró, para poder rastrearlo después
  createdAt   DateTime       @default(now())
  pickedAt    DateTime?      // cuando el agente lo agarró
  finishedAt  DateTime?      // cuando reportó done/failed
}

/// Cada PC que tiene el agente instalado.
///
/// Existe porque la impresora es una sola y va cambiando de computadora.
/// Cada agente reporta si la ve enchufada o no, y la cola solo le entrega
/// trabajos al que en ese momento la tiene: así el sistema manda la
/// etiqueta a donde está el papel sin que nadie tenga que elegir.
model PrintAgent {
  id            String   @id @default(cuid())
  name          String   @unique // hostname de la PC, o LILUS_AGENT_NAME
  printerStatus String   @default("unknown") // ok | printing | offline | error | stopped
  printerName   String? // la impresora que el agente encontró
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
}

enum PrintJobStatus {
  PENDING
  PICKED_UP
  DONE
  FAILED
}
