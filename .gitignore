# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# El ejemplo si va: es la documentacion de que variables hacen falta,
# y sin el nadie sabe que configurar en una instalacion nueva.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Uploads de usuario (imágenes y PDFs de etiquetas)
/public/uploads

# SQLite — NUNCA versionar la base de datos.
# En produccion vive fuera del repo (ver DATABASE_URL en .env), pero
# cubrimos todos los patrones para que un `git add -A` no la arrastre.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Print agent — secretos y logs
/print-agent/.env
/print-agent/agent.log
/print-agent/node_modules
/print-agent/nssm.exe
# La plantilla SÍ va al repo: sin ella el primer paso del README
# ("copy .env.example .env") no se puede hacer en una PC nueva.
!/print-agent/.env.example

# Python (los generadores de PDF)
__pycache__/
*.pyc

# App de Android: lo genera `expo prebuild`, se recrea con un comando.
# La llave de firma SÍ va al repo (app-movil/android/app/lilus.keystore):
# sin ella, un APK nuevo no se puede instalar encima del anterior.
/app-movil/android/
/app-movil/ios/
/app-movil/.expo/
/app-movil/google-services.json
/app-movil/dist/
/prisma/comprobantes/
/.tesseract/

# Spike de despliegue a Cloudflare
.open-next/
