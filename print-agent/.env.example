# URL pública de tu LILUS (Cloudflare Tunnel o similar)
LILUS_SERVER_URL=https://tu-tunnel.trycloudflare.com

# Token compartido. Debe coincidir con el configurado en LILUS → Configuración.
LILUS_AGENT_TOKEN=cambia-esto-por-un-secreto-largo

# Intervalo de polling en milisegundos. 2000 = 2 seg. Más rápido = más responsivo
# pero más tráfico.
LILUS_POLL_INTERVAL_MS=2000

# Cómo se llama esta PC en la pantalla de Configuración. Si se deja vacío usa
# el nombre de la computadora en Windows, que ya sirve. Solo hace falta ponerlo
# si el nombre real no dice nada (tipo "DESKTOP-3TA5CB4") y prefieres algo como
# "taller" o "primer-piso".
# LILUS_AGENT_NAME=
