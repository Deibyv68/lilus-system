# Copia este archivo como `.env` y llena los valores.
# El `.env` de verdad NO se sube al repositorio.

# ── Base de datos ──
DATABASE_URL="file:./dev.db"

# ── Dirección pública del sitio ──
# Los correos llevan enlaces, y un enlace necesita el dominio completo:
# el correo se abre en Gmail, no dentro del sitio. Mientras no haya dominio
# propio, aquí va la URL del túnel de Cloudflare.
APP_URL="http://localhost:3000"

# ── Correo ──
# Si esto no está, el sistema NO se rompe: no manda avisos y lo deja
# anotado en el log. La tienda sigue tomando pedidos igual.
#
# Con Gmail:
#   1. La cuenta necesita verificación en dos pasos activada.
#   2. Generar una "contraseña de aplicación" en
#      https://myaccount.google.com/apppasswords
#   3. Esa contraseña de 16 letras va en SMTP_PASS.
#
# La contraseña normal de la cuenta NO sirve, y además nunca debería
# quedar escrita en un archivo.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Cómo aparece el remitente en la bandeja de quien recibe.
MAIL_FROM="LILUS <tu-correo@gmail.com>"

# A dónde llegan los avisos de venta nueva. Si se deja vacío, se usa
# SMTP_USER.
MAIL_ADMIN=""
